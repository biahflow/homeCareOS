# Ambiente de execução: local / homolog / production.
ENVIRONMENT=local

# String de conexão do Postgres (SQLAlchemy + driver psycopg 3).
DATABASE_URL=postgresql+psycopg://homecareos:homecareos@localhost:5434/homecareos

# Storage das evoluções escaneadas (MinIO local; vazio = S3 real).
S3_ENDPOINT_URL=http://localhost:9002
S3_BUCKET=homecareos-documentos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Extração assistida por IA (Claude). Vazio desabilita a extração.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Tamanho máximo de upload, em bytes (32 MiB).
MAX_UPLOAD_BYTES=33554432

# DPI usado para renderizar páginas de PDF para conferência visual.
PDF_RENDER_DPI=200

# Chaves de API válidas para autenticar `X-API-Key` em toda rota `/api/*`,
# separadas por vírgula (permite rotação sem downtime). Vazio só é aceito com
# ENVIRONMENT=local; em qualquer outro ambiente a aplicação recusa subir.
API_KEYS=

# Papéis que a `X-API-Key` carrega, separados por vírgula — conferente,
# coordenador e/ou gestor (ADR 0007).
#
# **Vazio (o default) significa que a chave não abre rota de papel restrito
# nenhuma**: ela continua autenticando — chave errada segue respondendo 401 —
# mas toda rota de `/api/*` responde 403 para ela. Autenticar e autorizar são
# duas perguntas, e esta variável responde a segunda.
#
# Abrir a chave é uma DECISÃO, não um default: `API_KEY_PAPEIS=conferente,
# coordenador,gestor` devolve o acesso total que ela tinha antes do ADR 0007, e
# é o que a integração máquina-a-máquina que precisa de tudo deve declarar. Uma
# integração que só lê relatório pede `conferente`, e não os três.
#
# Nome de papel desconhecido **não** é ignorado: a aplicação recusa subir, em
# qualquer ambiente. Um typo que degradasse para "sem papel" faria a integração
# tomar 403 em tudo sem dizer por quê.
API_KEY_PAPEIS=

# Responsável atribuído a toda pendência aberta pela classificação automática.
# A classificação é automática e não tem pessoa; a atribuição a alguém de
# verdade é feita depois, em PATCH /api/pendencias/{id} (que aceita
# `responsavel_id` de um usuário cadastrado).
PENDENCIA_RESPONSAVEL_PADRAO=equipe-conferencia

# Duração da sessão de usuário, em horas. 12h cobre um turno inteiro sem
# obrigar relogin no meio do fechamento de competência.
SESSAO_DURACAO_HORAS=12

# Nome do cookie httpOnly que carrega o token opaco de sessão. Trocar este
# valor troca o cookie de verdade e desatualiza a declaração do esquema de
# segurança no OpenAPI — é operação de exceção, não ajuste de rotina.
SESSAO_COOKIE_NOME=homecareos_sessao

# Freio para força bruta contra POST /api/auth/login (issue #33). Ver a seção
# "Bloqueio por tentativa de login" do README de apps/api.
# Janela de observação das tentativas de login, em minutos.
LOGIN_JANELA_MINUTOS=15
# Falhas na janela que travam a origem (IP).
LOGIN_FALHAS_PARA_TRAVAR_IP=10
# Falhas na janela que travam a conta. MUITO mais alto que o de IP: travar
# conta é o último recurso, não o primeiro — um limiar baixo deixaria
# qualquer um que soubesse o e-mail de alguém mantê-la fora do sistema.
LOGIN_FALHAS_PARA_TRAVAR_CONTA=20
# Duração da trava (IP ou conta), em minutos — é o que sai no Retry-After.
LOGIN_TRAVA_MINUTOS=15
# Atraso progressivo por conta+IP, em segundos: base e teto. O TETO não é
# ajuste fino — sem ele, requisições baratas esgotam o threadpool do FastAPI
# e o próprio atraso vira o ataque.
LOGIN_ATRASO_BASE_SEGUNDOS=0.25
LOGIN_ATRASO_MAXIMO_SEGUNDOS=2.0
# `X-Forwarded-For` só é confiável quando existe um proxy que o reescreve.
# `false` por padrão: confiar sem proxy deixaria qualquer um forjar a origem e
# escapar da trava de IP. LIGUE em deploy atrás de proxy — sem isto, toda
# requisição parece vir do balanceador e a trava de IP trava o mundo inteiro
# de uma vez (falha FECHADA, não aberta).
CONFIAR_EM_X_FORWARDED_FOR=false

# Gateway de e-mail (SMTP) da recuperação de senha (issue #34). HOST **ou**
# REMETENTE vazio DESLIGA a recuperação: o endpoint continua respondendo 204
# (ele responde 204 sempre), registra um warning no log e o caminho para
# redefinir senha volta a ser o CLI. Em produção isso significa que ninguém
# recebe nada e a única pista é o log — configure os dois.
# A senha SMTP é credencial de envio (quem a tem manda e-mail em nome da
# empresa): ela nunca é logada nem aparece em repr ou mensagem de erro.
SMTP_HOST=
# 587 é STARTTLS, que é o que esta entrega suporta. A porta 465 (TLS
# implícito) NÃO é suportada.
SMTP_PORTA=587
# Vazios são válidos: relay interno autenticado por IP não pede credencial.
SMTP_USUARIO=
SMTP_SENHA=
# Aceita "Nome <caixa@dominio>" ou só o endereço.
SMTP_REMETENTE=
SMTP_USAR_TLS=true
SMTP_TIMEOUT_SEGUNDOS=10.0

# Base do link que vai no e-mail de recuperação: quem renderiza a tela de
# redefinição é o frontend, não a API.
FRONTEND_BASE_URL=http://localhost:3000

# Vida do token de recuperação, em minutos. Curta de propósito: é uma
# credencial que troca senha e fica parada numa caixa postal.
SENHA_RESET_VALIDADE_MINUTOS=30
# Teto de e-mails de recuperação por usuário por hora. Sem ele, o endpoint —
# que é público — vira metralhadora contra a caixa postal de quem nem pediu.
SENHA_RESET_MAX_POR_HORA=3
# Piso de tamanho de senha, aplicado na redefinição E no CLI. Só comprimento,
# de propósito: exigir maiúscula/dígito/símbolo empurra para `Senha@123` e não
# aumenta entropia real.
SENHA_MINIMA_CARACTERES=12

# Segundo fator por TOTP em app autenticador (issue #35). Ver a seção "Segundo
# fator (MFA por TOTP)" do README de apps/api — inclusive a limitação declarada:
# o segredo TOTP fica EM CLARO no banco.
# Emissor mostrado no app autenticador, no QR code e na lista de contas.
MFA_EMISSOR=HomeCareOS
# Tolerância de passos TOTP para relógio dessincronizado. 1 = aceita o passo
# anterior e o seguinte (±30s). Subir isto alarga a janela de quem intercepta o
# código: cada passo a mais são 30 segundos a mais de vida para um código já
# visto.
MFA_JANELA_PASSOS=1
# Quantos códigos de recuperação a ativação gera. São a única saída de quem
# perdeu o celular, e são mostrados uma única vez.
MFA_CODIGOS_RECUPERACAO=8

# Portas publicadas no host pelo docker-compose. Os defaults evitam colisão com
# outros projetos que costumam rodar na mesma máquina (5432, 8000, 9000/9001).
POSTGRES_PORT=5434
API_PORT=8001
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9003

# Teto de custo por lote de extração, em dólares. A reserva acontece ANTES de
# cada chamada ao modelo: estourou o teto, a chamada não sai.
EXTRACTION_MAX_COST_USD_PER_BATCH=5.0
EXTRACTION_COST_PER_CALL_USD=0.05

# Gateway de WhatsApp (uazapi) que entrega os alertas. A base URL é POR
# INSTÂNCIA (https://<subdominio>.uazapi.com) e o token é o da instância —
# quem o tem manda mensagem em nome da empresa, então ele nunca é logado nem
# gravado no banco. Base URL vazia OU token vazio desabilita todo o envio de
# alerta: o sistema segue conferindo documento, só não notifica.
UAZAPI_BASE_URL=
UAZAPI_TOKEN=
ALERTAS_TIMEOUT_SEGUNDOS=10.0

# ATENÇÃO: ESTA VARIÁVEL NÃO LIGA NEM DESLIGA CANAL NENHUM.
#
# Desde o ADR 0006 (parte 2) o liga/desliga vive no BANCO, na tabela
# `canais_alerta`, e quem o muda é o coordenador — pela tela ou por
# `PATCH /api/alertas/canais/{canal}`, com a mudança auditada. Editar a linha
# abaixo num sistema já migrado não tem efeito nenhum.
#
# Ela permanece por um motivo só: a migration que criou aquela tabela a leu
# UMA VEZ, para semear o estado inicial, e assim quem rodava com
# `ALERTAS_CANAIS=whatsapp` não mudou de comportamento no deploy. Em um banco
# criado do zero ela ainda é essa semente — e um canal desconhecido aqui faz a
# migration PARAR, com mensagem: um typo não pode virar "todos desligados".
#
# O que continua valendo do `.env` é a outra metade da conta (ADR 0006):
#
#     canal habilitado (banco)  x  credencial presente (.env)  =  canal envia
#
# O canal de e-mail usa o MESMO SMTP da recuperação de senha (SMTP_HOST /
# SMTP_REMETENTE, acima): ligar `email` sem eles não envia nada e não estoura —
# `GET /api/alertas/canais` e o resumo da varredura mostram
# `habilitado: true, disponivel: false`.
#
# Válidos: whatsapp, email.
ALERTAS_CANAIS=whatsapp

# Destinatários por tipo de alerta, em JSON. **Só o canal de WhatsApp usa esta
# lista** — são telefones, e não há telefone no cadastro de usuário. Tipo
# ausente = alerta desligado neste canal; tipo desconhecido é erro (um typo
# silencioso seria "nunca mais recebi esse alerta e não sei por quê"). Tipos
# válidos: documento_incompleto_critico, deadline_competencia, volume_anormal,
# pendencia_parada.
# Ex.: {"documento_incompleto_critico":["5521999999999"]}
ALERTAS_DESTINATARIOS=

# Quais papéis recebem cada tipo por E-MAIL, em JSON. O canal de e-mail resolve
# destinatário por papel: os e-mails das contas ATIVAS com aquele papel. Quem
# é desativado para de receber no mesmo instante, sem ninguém editar variável.
#
# Sobrescrita PARCIAL: tipo ausente aqui usa o default abaixo; lista vazia
# desliga o tipo neste canal. Papel válido: conferente, coordenador, gestor.
# Ex.: {"volume_anormal":["gestor"]}
#
# DEFAULT (ASSUNÇÃO deste time, NÃO requisito confirmado pelo cliente — o ADR
# 0006 deixa isto explicitamente em aberto, como calibragem de produto):
#   documento_incompleto_critico -> coordenador
#   deadline_competencia         -> coordenador
#   pendencia_parada             -> coordenador
#   volume_anormal               -> coordenador, gestor
# Os três primeiros são item individual: alguém precisa agir NAQUELE documento.
# `volume_anormal` é o único sinal agregado dos quatro ("a taxa de problema do
# dia saiu da média"), que é leitura da operação — o que o gestor faz (ADR
# 0001). Mandar ao gestor um aviso por documento o encheria de item que ele não
# vai tratar, e alerta que não se trata ensina a ignorar o canal.
ALERTAS_PAPEIS_EMAIL=

# Sobrescrita opcional dos templates, em JSON. Duas formas convivem:
#   {"<tipo>": "<template>"}                       -> template de WhatsApp
#   {"<tipo>": {"whatsapp": "...",
#               "email_assunto": "...",
#               "email_corpo": "..."}}             -> espaço a espaço
# A primeira é a que já existe em produção e continua valendo sem reescrita.
# Espaço ausente = não sobrescrito; espaço desconhecido é erro.
# Placeholder inexistente no template customizado não derruba nem cala o
# alerta: cai para o template padrão daquele espaço e registra um warning.
ALERTAS_TEMPLATES=

# Anti-bombardeio. O teto por hora protege a PESSOA (desde o ADR 0006 ele conta
# por usuário quando o sistema sabe de quem é o endereço, e por endereço quando
# não sabe — senão ligar o segundo canal dobraria o teto sem ninguém pedir); o
# cooldown impede repetir o MESMO assunto no mesmo endereço (a varredura roda
# de minuto em minuto no cron). O mesmo aviso SAI nos dois canais de propósito:
# são canais independentes, não reserva um do outro.
ALERTAS_MAX_POR_HORA_POR_DESTINATARIO=10
ALERTAS_COOLDOWN_HORAS=24

# Parâmetros dos detectores. O piso de volume mínimo existe para um único
# documento com problema num dia parado não dar 100% de taxa e disparar alerta
# todo dia.
ALERTAS_DIAS_ANTES_DEADLINE=3
ALERTAS_HORAS_PENDENCIA_PARADA=48
ALERTAS_VOLUME_JANELA_DIAS=14
ALERTAS_VOLUME_FATOR=1.5
ALERTAS_VOLUME_MINIMO_DOCUMENTOS=10

# Dispara o alerta de documento incompleto crítico já na classificação, além
# da varredura. É síncrono e está no caminho do upload; `false` deixa o caso
# apenas para a varredura periódica.
ALERTAS_HOOK_INLINE_HABILITADO=true

# Retenção e expurgo de dados (issue #39). `tentativas_login`,
# `tokens_recuperacao` e `alertas_enviados` crescem sem limite e não são só
# log: as três são consultadas por freios de segurança ativos dentro de
# janelas de tempo (trava de login, teto de emissão de token de recuperação,
# cooldown/rate limit de alertas). Apagar dentro dessas janelas desarma o
# freio — ver "Retenção e expurgo de dados" no README de apps/api.
# `auditoria_usuarios` também cresce sem limite, mas não tem freio lendo: o
# piso dela é o propósito da tabela, não uma janela. Os quatro defaults de
# dias abaixo são ASSUNÇÃO deste time e precisam de confirmação do
# cliente/jurídico antes de valer como política real.
#
# Registro de acesso à aplicação; 180 dias (~6 meses) é o horizonte que o
# Marco Civil da Internet (Lei 12.965/2014, art. 15) estabelece para provedor
# de aplicações com fins econômicos.
RETENCAO_TENTATIVAS_LOGIN_DIAS=180
# O valor de auditoria é curto ("pediram redefinição da minha senha semana
# passada?"); o token em si já morre em SENHA_RESET_VALIDADE_MINUTOS (30 min).
# Um token ainda válido e não usado NUNCA é apagado por idade.
RETENCAO_TOKENS_RECUPERACAO_DIAS=30
# `mensagem` guarda o texto enviado, incluindo o nome do paciente — aqui a
# LGPD empurra para reter MENOS, desde que fique muito acima do cooldown de
# 24h (ALERTAS_COOLDOWN_HORAS).
RETENCAO_ALERTAS_ENVIADOS_DIAS=90
# 1825 dias (5 anos): auditoria de quem deu acesso a prontuário se consulta
# anos depois, em investigação ou auditoria externa — é prova de quem
# autorizou o quê, não log operacional. Contrapeso declarado e não resolvido:
# `alvo_email` é dado pessoal, e cinco anos é bastante tempo; a favor, reter
# auditoria de acesso a dado de saúde é o caso em que reter se defende;
# contra, a minimização. Abaixo de 365 dias o expurgo RECUSA rodar, e esse
# piso não é configurável (MINIMO_AUDITORIA_USUARIOS, em
# apps/api/src/homecareos/retencao/janelas.py).
RETENCAO_AUDITORIA_USUARIOS_DIAS=1825
# Auditoria das mudanças de canal de alerta (ADR 0006): quem ligou, quem
# desligou, quando. Mesmo número da auditoria administrativa, e alinhar em vez
# de inventar um segundo valor é deliberado — a pergunta que ela responde
# ("desde quando a operação está sem aviso?") também aparece em investigação,
# não no trimestre do evento. É a mais leve das duas em dado pessoal: guarda o
# e-mail do ator (funcionário) e nenhum e-mail de alvo. Piso de 365 dias, também
# não configurável (MINIMO_AUDITORIA_CANAIS). ASSUNÇÃO deste time.
RETENCAO_AUDITORIA_CANAIS_DIAS=1825
# Tamanho do lote de apagar por vez, com commit a cada lote — um DELETE único
# sobre anos de dado acumulado seguraria locks e cresceria o WAL de uma vez só
# numa tabela que recebe insert a cada login.
# Contador do rate limit das rotas caras (ADR 0005). Perde utilidade rápido:
# passada a janela de uma hora do freio, a linha não decide mais nada. Os 30 dias
# são para investigação ("por que tomei 429 na terça?"), não para o freio — e o
# expurgo recusa qualquer retenção abaixo de 2h, que devolveria cota a quem
# acabou de estourar o limite. ASSUNÇÃO deste time, como os demais.
RETENCAO_CONSUMOS_RATE_LIMIT_DIAS=30

RETENCAO_TAMANHO_LOTE=1000

# Rate limit das rotas caras, por identidade do principal (ADR 0005, issue #39).
# Só quatro rotas de /api/* entram — o upload que chama o provider de IA, o CSV
# sem paginação, o streaming do arquivo e a varredura que envia WhatsApp. As
# leituras paginadas continuam sem limite: cobrar de todas o preço de proteger
# quatro seria custo certo contra risco hipotético. A chave é a IDENTIDADE de
# quem chama (usuário ou a chave de máquina), nunca o IP — atrás de proxy, um
# limite por IP ou tranca a equipe inteira num contador só ou não tranca
# ninguém. Ver "Rate limit das rotas caras" no README de apps/api.
#
# OS OITO NÚMEROS ABAIXO SÃO ASSUNÇÃO, NÃO REQUISITO MEDIDO: ninguém mediu o uso
# real ainda, e o ADR registra que calibrar sem medir produz número inventado
# com cara de decisão. Eles nascem FOLGADOS de propósito — o pior desfecho deste
# freio é uma conferente bloqueada no meio do turno, que não abre chamado
# dizendo "recebi 429" e sim que o sistema parou. A janela é de 1 hora para os
# quatro recursos, e é constante no código (`limites/protecao.JANELA`).
#
# A chave de máquina (X-API-Key) tem limite próprio e mais folgado em todos os
# recursos: o padrão de uso dela é legítimo e repetitivo.
#
# Upload: a única rota cujo abuso custa dinheiro. Uma conferente processando sem
# parar não passa de algumas dezenas por hora; 120 é folga de 2-3x.
LIMITE_UPLOAD_DOCUMENTO_PESSOA_POR_HORA=120
LIMITE_UPLOAD_DOCUMENTO_MAQUINA_POR_HORA=600
# CSV completo: ninguém exporta o extrato inteiro 20 vezes por hora com propósito.
LIMITE_RELATORIO_CSV_PESSOA_POR_HORA=20
LIMITE_RELATORIO_CSV_MAQUINA_POR_HORA=60
# Download do arquivo: abrir documento é o gesto mais frequente da conferência —
# este limite existe para conter LAÇO, não uso.
LIMITE_DOWNLOAD_ARQUIVO_PESSOA_POR_HORA=600
LIMITE_DOWNLOAD_ARQUIVO_MAQUINA_POR_HORA=600
# Varredura de alertas: envia WhatsApp de verdade. Apertado para pessoa, folgado
# para máquina (o cron de produção chama o módulo `homecareos.alerts.scan`, não
# a rota HTTP, e não é afetado por este limite).
LIMITE_VARREDURA_ALERTAS_PESSOA_POR_HORA=30
LIMITE_VARREDURA_ALERTAS_MAQUINA_POR_HORA=600
