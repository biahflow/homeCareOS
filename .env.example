# Ambiente de execução: local / homolog / production.
ENVIRONMENT=local

# String de conexão do Postgres (SQLAlchemy + driver psycopg 3).
DATABASE_URL=postgresql+psycopg://homecareos:homecareos@localhost:5434/homecareos

# Storage das evoluções escaneadas (MinIO local; vazio = S3 real).
S3_ENDPOINT_URL=http://localhost:9002
S3_BUCKET=homecareos-documentos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Extração assistida por IA (Claude). Vazio desabilita a extração.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Tamanho máximo de upload, em bytes (32 MiB).
MAX_UPLOAD_BYTES=33554432

# DPI usado para renderizar páginas de PDF para conferência visual.
PDF_RENDER_DPI=200

# Chaves de API válidas para autenticar `X-API-Key` em toda rota `/api/*`,
# separadas por vírgula (permite rotação sem downtime). Vazio só é aceito com
# ENVIRONMENT=local; em qualquer outro ambiente a aplicação recusa subir.
API_KEYS=

# Responsável atribuído a toda pendência aberta pela classificação automática.
# A classificação é automática e não tem pessoa; a atribuição a alguém de
# verdade é feita depois, em PATCH /api/pendencias/{id} (que aceita
# `responsavel_id` de um usuário cadastrado).
PENDENCIA_RESPONSAVEL_PADRAO=equipe-conferencia

# Duração da sessão de usuário, em horas. 12h cobre um turno inteiro sem
# obrigar relogin no meio do fechamento de competência.
SESSAO_DURACAO_HORAS=12

# Nome do cookie httpOnly que carrega o token opaco de sessão. Trocar este
# valor troca o cookie de verdade e desatualiza a declaração do esquema de
# segurança no OpenAPI — é operação de exceção, não ajuste de rotina.
SESSAO_COOKIE_NOME=homecareos_sessao

# Portas publicadas no host pelo docker-compose. Os defaults evitam colisão com
# outros projetos que costumam rodar na mesma máquina (5432, 8000, 9000/9001).
POSTGRES_PORT=5434
API_PORT=8001
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9003

# Teto de custo por lote de extração, em dólares. A reserva acontece ANTES de
# cada chamada ao modelo: estourou o teto, a chamada não sai.
EXTRACTION_MAX_COST_USD_PER_BATCH=5.0
EXTRACTION_COST_PER_CALL_USD=0.05

# Gateway de WhatsApp (uazapi) que entrega os alertas. A base URL é POR
# INSTÂNCIA (https://<subdominio>.uazapi.com) e o token é o da instância —
# quem o tem manda mensagem em nome da empresa, então ele nunca é logado nem
# gravado no banco. Base URL vazia OU token vazio desabilita todo o envio de
# alerta: o sistema segue conferindo documento, só não notifica.
UAZAPI_BASE_URL=
UAZAPI_TOKEN=
ALERTAS_TIMEOUT_SEGUNDOS=10.0

# Destinatários por tipo de alerta, em JSON. Tipo ausente = alerta desligado;
# tipo desconhecido é erro (um typo silencioso seria "nunca mais recebi esse
# alerta e não sei por quê"). Tipos válidos: documento_incompleto_critico,
# deadline_competencia, volume_anormal, pendencia_parada.
# Ex.: {"documento_incompleto_critico":["5521999999999"]}
ALERTAS_DESTINATARIOS=

# Sobrescrita opcional dos templates, em JSON: {"<tipo>": "<template>"}.
# Placeholder inexistente no template customizado não derruba nem cala o
# alerta: cai para o template padrão e registra um warning.
ALERTAS_TEMPLATES=

# Anti-bombardeio. O teto por hora protege a pessoa; o cooldown impede repetir
# o MESMO assunto (a varredura roda de minuto em minuto no cron).
ALERTAS_MAX_POR_HORA_POR_DESTINATARIO=10
ALERTAS_COOLDOWN_HORAS=24

# Parâmetros dos detectores. O piso de volume mínimo existe para um único
# documento com problema num dia parado não dar 100% de taxa e disparar alerta
# todo dia.
ALERTAS_DIAS_ANTES_DEADLINE=3
ALERTAS_HORAS_PENDENCIA_PARADA=48
ALERTAS_VOLUME_JANELA_DIAS=14
ALERTAS_VOLUME_FATOR=1.5
ALERTAS_VOLUME_MINIMO_DOCUMENTOS=10

# Dispara o alerta de documento incompleto crítico já na classificação, além
# da varredura. É síncrono e está no caminho do upload; `false` deixa o caso
# apenas para a varredura periódica.
ALERTAS_HOOK_INLINE_HABILITADO=true
